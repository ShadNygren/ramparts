# Environment variables for Ramparts Docker deployment
# Copy this file to .env and update with your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4
LLM_URL=https://api.openai.com/v1

# Azure OpenAI Configuration (alternative)
# OPENAI_API_KEY=your_azure_openai_key_here
# LLM_MODEL=gpt-4
# LLM_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment/

# Other LLM Providers
# Anthropic Claude
# LLM_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-3-sonnet-20240229

# Local LLM (Ollama)
# LLM_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# Ramparts Configuration
RAMPARTS_MCP_STDIO=1
RUST_LOG=info
RUST_BACKTRACE=1

# Development settings
# CARGO_TERM_COLOR=always